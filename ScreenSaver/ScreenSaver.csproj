<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Aerial</RootNamespace>
    <AssemblyName>Aerial</AssemblyName>
    <ApplicationIcon>imgs\bridge.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>7.0.0</Version>
    <Product>Aerial</Product>
    <Description>Aerial Screensaver for Windows</Description>
    <Company>Dmitry Sadakov</Company>
    <Copyright>Copyright © 2017 Dmitry Sadakov</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AxInterop.WMPLib">
      <HintPath>libs\AxInterop.WMPLib.dll</HintPath>
    </Reference>
    <Reference Include="Interop.WMPLib">
      <HintPath>libs\Interop.WMPLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.*" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Readme.md" Link="docs\Readme.md" />
    <None Include="..\Todo.md" Link="docs\Todo.md" />
  </ItemGroup>

  <Target Name="CopyScreenSaver" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe" DestinationFiles="$(TargetDir)$(TargetName).scr" />
  </Target>

</Project>
